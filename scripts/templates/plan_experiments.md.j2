<script id="plan-experiments-config" type="application/json">
{{ plan_experiments_config_json | safe }}
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const configNode = document.getElementById("plan-experiments-config");
    let pageConfig = {
      facility_short_name: "Core Imaging Facility",
      facility_contact_url: "#",
      facility_contact_label: "Contact Core Imaging Facility Staff",
      llm_inventory_asset_url: "assets/llm_inventory.json",
    };
    try {
      if (configNode?.textContent?.trim()) {
        pageConfig = JSON.parse(configNode.textContent);
      }
    } catch (error) {
      console.error("Failed to parse plan-experiments config", error);
    }

    const facilityShortName = String(pageConfig?.facility_short_name || "Core Imaging Facility");
    const inputArea = document.getElementById("experiment-desc");
    const outputArea = document.getElementById("generated-prompt");
    const copyBtn = document.getElementById("copy-prompt-btn");

    const basePromptTop = `You are helping me explore microscopy options using the attached ${facilityShortName} inventory.

Use the JSON as the only source for facility-specific facts.

Rules:
- Read planning_contract first. It explains which route lists are complete and which information is not recorded.
- A component missing from a complete route hardware list is not on that route. A missing or null value anywhere else is unknown.
- Use llm_context.authoritative_route_contract as the source of truth for routes. llm_context.route_planning_summary and hardware_focus_summary are convenience views; raw hardware lists are secondary context and must not override route contract truth.
- Never build a configuration by combining components from different routes.
- Objectives are recorded per instrument, not per route. Do not claim objective-to-route compatibility unless the inventory explicitly establishes it.
- Respect branch selectors and splitters exactly as recorded. Do not silently choose an unresolved/selectable branch or endpoint.
- Use capability_route_reconciliation and route_family_coverage to relate recorded capabilities such as TIRF, STED or SIM to their recorded route families. Do not invent a route type.
- The inventory records no booking, access or training availability. Operational/QC status is not booking availability.
- Do not turn an unrecorded performance or suitability detail into a facility fact. If the inventory does not establish speed, depth, phototoxicity, sample compatibility, long-run suitability, fluorophore compatibility or another requested constraint, label it unknown and say what should be confirmed.
- Do not force a ranking. In particular, do not follow the legacy instruction "Choose one best route on the top instrument and one backup route/instrument" when the inventory does not support that conclusion.

Use this required procedure in order:
1. Separate known vs unknown facts in my request and the inventory.
2. Exclude instruments whose recorded routes cannot support the experiment only when an explicit inventory fact establishes the mismatch.
3. Identify the supported candidate routes from the authoritative route contract without inventing missing suitability information.
4. For each selected route, verify the detector/endpoint and any claimed route components. Keep instrument-level objective(s) separate unless route compatibility is explicit.
5. Preserve branch/splitter handling exactly as recorded and list unresolved points or staff confirmations.

My request:
`;

    const basePromptBottom = `

Return a concise answer with:
1. What the inventory clearly establishes.
2. Candidate instruments/routes supported by those recorded facts; if the inventory cannot narrow the options, say so.
3. For each candidate you discuss, the selected route, detector/endpoint, and recorded route components without mixing routes.
4. Instrument-level objective(s) only when useful, clearly labelled as instrument-level unless route compatibility is explicit.
5. Unknown or unrecorded details that matter, and what to confirm with ${facilityShortName} staff.

Do not invent facility specifications or force a best microscope or backup when the inventory does not justify one.`;

    function updatePrompt() {
      const userText = inputArea.value.trim();
      const desc = userText ? userText : "[Describe what you want to image or measure, in your own words.]";
      outputArea.value = basePromptTop + desc + basePromptBottom;
    }

    inputArea.addEventListener("input", updatePrompt);
    updatePrompt();

    copyBtn.addEventListener("click", () => {
      outputArea.select();
      outputArea.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(outputArea.value).then(() => {
        const originalText = copyBtn.innerText;
        copyBtn.innerText = "Copied";
        setTimeout(() => { copyBtn.innerText = originalText; }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  });
</script>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const configNode = document.getElementById("plan-experiments-config");
    let pageConfig = {
      facility_short_name: "Core Imaging Facility",
      facility_contact_url: "#",
      facility_contact_label: "Contact Core Imaging Facility Staff",
      llm_inventory_asset_url: "assets/llm_inventory.json",
    };
    try {
      if (configNode?.textContent?.trim()) {
        pageConfig = JSON.parse(configNode.textContent);
      }
    } catch (error) {
      console.error("Failed to parse plan-experiments config", error);
    }

    const facilityShortName = String(pageConfig?.facility_short_name || "Core Imaging Facility");
    const inputArea = document.getElementById("experiment-desc");
    const outputArea = document.getElementById("generated-prompt");
    const copyBtn = document.getElementById("copy-prompt-btn");

    const basePromptTop = `You are helping me plan a microscopy experiment using the attached ${facilityShortName} inventory.

Use the JSON as the only source for facility-specific facts.

Rules:
- Route truth comes from llm_context.authoritative_route_contract.routes[]. Never build a route by combining hardware from different routes.
- llm_context.route_planning_summary is a convenience view only; verify route claims against llm_context.authoritative_route_contract.routes[].
- Raw hardware lists and hardware_focus_summary are instrument-level context only. They do not prove that a component is usable on a particular route.
- An installed objective is not route-compatible merely because it appears on the same instrument. Claim objective-to-route compatibility only if the route data explicitly establishes it; otherwise mark it unknown.
- Respect branch selectors and splitters exactly as recorded. If a selector is unresolved/selectable, do not silently choose a position or endpoint.
- Capability/readout classifications describe recorded semantics; they are not component identities and do not prove that unlisted hardware exists.
- Treat missing, null, empty, or unrecorded values as unknown, not as false and not as available.
- Operational/QC status is not booking or access availability. Do not infer availability unless it is explicitly recorded.
- Do not infer fluorophore compatibility, acquisition speed, imaging depth, phototoxicity, sample compatibility, or long-term environmental suitability from general microscopy knowledge when the inventory does not record the needed facts.
- If the inventory cannot establish a suitable route, say so. Do not invent a microscope, component, wavelength, objective, detector, route, endpoint, or configuration.

Procedure:
1. Translate my request into requirements, separating explicit requirements from assumptions.
2. Eliminate only instruments/routes that are definitely impossible from recorded facts.
3. For each remaining candidate, verify the exact route and endpoint from the authoritative route contract.
4. Check every claimed component against that same route; keep instrument-level hardware separate.
5. Report unresolved selectors, missing metadata, and anything needing staff confirmation.

My experiment:
`;

    const basePromptBottom = `

Return a concise answer with:
1. Recorded requirements and unknowns.
2. Definitely impossible instruments/routes, with the inventory fact that excludes them.
3. Supported candidate routes and endpoints. If none can be established, say that clearly.
4. Components you can claim for each route, without mixing routes.
5. Instrument-level objective options only when useful, clearly labelled as not route-compatibility evidence unless explicitly linked.
6. Missing information and staff confirmations needed before booking.

Do not force a best microscope or backup when the repository does not support that conclusion. Finish with the items I should confirm with ${facilityShortName} staff.`;

    function updatePrompt() {
      const userText = inputArea.value.trim();
      const desc = userText ? userText : "[Describe the sample, live/fixed state, fluorophores, imaging depth, required resolution, acquisition speed or duration, and phototoxicity constraints.]";
      outputArea.value = basePromptTop + desc + basePromptBottom;
    }

    inputArea.addEventListener("input", updatePrompt);
    updatePrompt();

    copyBtn.addEventListener("click", () => {
      outputArea.select();
      outputArea.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(outputArea.value).then(() => {
        const originalText = copyBtn.innerText;
        copyBtn.innerText = "Copied";
        setTimeout(() => { copyBtn.innerText = originalText; }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  });
</script>


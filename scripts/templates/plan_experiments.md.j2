<script>
  document.addEventListener("DOMContentLoaded", () => {
    const configNode = document.getElementById("plan-experiments-config");
    let pageConfig = {
      facility_short_name: "Core Imaging Facility",
      facility_contact_url: "#",
      facility_contact_label: "Contact Core Imaging Facility Staff",
      llm_inventory_asset_url: "assets/llm_inventory.json",
    };
    try {
      if (configNode?.textContent?.trim()) {
        pageConfig = JSON.parse(configNode.textContent);
      }
    } catch (error) {
      console.error("Failed to parse plan-experiments config", error);
    }

    const facilityShortName = String(pageConfig?.facility_short_name || "Core Imaging Facility");
    const inputArea = document.getElementById("experiment-desc");
    const outputArea = document.getElementById("generated-prompt");
    const copyBtn = document.getElementById("copy-prompt-btn");

    const basePromptTop = `You are helping me plan a microscopy experiment using the attached ${facilityShortName} inventory.

Rules:
- Use the attached JSON as the only source for facility hardware, optical routes, and instrument status.
- Treat missing, null, or unknown values as unknown. Do not infer installed hardware.
- Recommend only microscopes and components present in the inventory.
- Exclude unavailable or incompatible microscopes before ranking the remaining options.
- Use llm_context.authoritative_route_contract.routes[] as the primary source for route truth. Use llm_context.route_planning_summary only as a convenience view of the same data.
- Raw hardware lists are secondary context and must not override route-contract data.
- Do not claim an objective, source, filter, detector, or other component is usable on a route unless the inventory supports that connection.
- If splitters or branch selectors are present, state the branch handling and final endpoint.
- Separate known facts from unknowns, assumptions, and caveats.
- If missing metadata could change the recommendation, say what is missing and advise me to confirm it with facility staff.

Follow this required procedure in order:
1. Eliminate unavailable or incompatible instruments first.
2. Identify candidate routes from the authoritative route contract.
3. Choose one best route on the top instrument and one backup route/instrument.
4. Check the selected route, optics, endpoint and relevant objectives against the route data.
5. Report branch handling for any splitter.
6. Separate known vs unknown facts.

Raw hardware lists are secondary context and must not override route contract truth.

My experiment:
`;

    const basePromptBottom = `

Please return:
1. The best-fit microscope and one backup, with brief evidence from the inventory.
2. The selected route and detector/readout for each recommendation, using only explicitly supported route data.
3. Relevant objective options where the inventory explicitly supports them.
4. Important trade-offs.
5. Missing metadata or assumptions that need staff confirmation.
6. A short acquisition plan and the settings I should record for methods reporting.

For each option, label the selected route, detector/endpoint, objective(s), and branch/splitter handling.

Keep the answer concise and grounded in the attached inventory. Finish by identifying anything I should confirm with ${facilityShortName} staff before booking.`;

    function updatePrompt() {
      const userText = inputArea.value.trim();
      const desc = userText ? userText : "[Describe the sample, live/fixed state, fluorophores, imaging depth, required resolution, acquisition speed or duration, and phototoxicity constraints.]";
      outputArea.value = basePromptTop + desc + basePromptBottom;
    }

    inputArea.addEventListener("input", updatePrompt);
    updatePrompt();

    copyBtn.addEventListener("click", () => {
      outputArea.select();
      outputArea.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(outputArea.value).then(() => {
        const originalText = copyBtn.innerText;
        copyBtn.innerText = "Copied";
        setTimeout(() => { copyBtn.innerText = originalText; }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  });
</script>


# Instrument fleet

Explore the microscopes available at AIC. Search by name or filter by capability, then open an instrument to see its recorded hardware, optical routes, objectives, status, and QC and maintenance history.

!!! info "Current status"
    **Total:** {{ counts.total }} · **Online:** {{ counts.green }} · **Warning:** {{ counts.yellow }} · **Offline:** {{ counts.red }}

Need a particular objective? [Browse the objective catalogue](objective_pool.md), filter by microscope, or check the **Spare pool**. Installation, condition, and availability are shown separately.

<div class="aic-fleetbar">
  <div class="aic-fleetbar__group">
    <label class="aic-label" for="aicSearch">Search</label>
    <input id="aicSearch" class="aic-input" type="search" placeholder="Name, manufacturer, model…" />
  </div>

  <div class="aic-fleetbar__group">
    <label class="aic-label" for="aicModality">Filter by capability</label>
    <select id="aicModality" class="aic-select">
      <option value="all">All</option>
      {% for capability in capability_filter_options %}
      <option value="{{ capability.id | lower }}">{{ capability.label }}</option>
      {% endfor %}
    </select>
  </div>

  <div class="aic-fleetbar__spacer"></div>

  <div class="aic-fleetbar__group aic-fleetbar__hint" markdown="span">
    Use the capability filter to narrow the list, or search for a microscope, manufacturer, or model.
  </div>
</div>

<div class="aic-grid">
  {% for inst in instruments %}
  <a class="aic-card aic-card--link" href="instruments/{{ inst.id }}/"
     data-name="{{ inst.display_name | lower }}"
     data-manufacturer="{{ inst.manufacturer | lower }}"
     data-model="{{ inst.model | lower }}"
     data-capabilities="{{ (inst.capabilities_primary_ids | default([])) | join(',') | lower }}"
     aria-label="Open {{ inst.display_name }}">

    <div class="aic-card__media">
      <img src="assets/images/{{ inst.image_filename }}" alt="{{ inst.display_name }}"
           onerror="this.onerror=null; this.src='assets/images/placeholder.svg';" />
      <div class="aic-badge aic-badge--{{ inst.status.color }}">{{ inst.status.badge }}</div>
    </div>

    <div class="aic-card__body">
      <div class="aic-card__title">{{ inst.display_name }}</div>
      <div class="aic-card__meta">{{ inst.manufacturer }}{% if inst.model %} · {{ inst.model }}{% endif %}</div>

      <div class="aic-chiprow">
        {% for cap in (inst.capabilities_primary | default([]))[:4] %}
          <span class="aic-chip">{{ cap.label }}</span>
        {% endfor %}
        {% if (inst.capabilities_primary | default([])) | length > 4 %}
          <span class="aic-chip aic-chip--muted">+{{ ((inst.capabilities_primary | default([])) | length) - 4 }}</span>
        {% endif %}
      </div>
    </div>

  </a>
  {% endfor %}
</div>

<script>
(function() {
  const capabilityEl = document.getElementById('aicModality');
  const searchEl = document.getElementById('aicSearch');
  const cards = Array.from(document.querySelectorAll('.aic-card'));

  function applyFilters() {
    const selectedCapability = (capabilityEl.value || 'all').toLowerCase();
    const q = (searchEl.value || '').trim().toLowerCase();

    cards.forEach(card => {
      const cardModsStr = card.getAttribute('data-capabilities') || '';
      const cardModsList = cardModsStr ? cardModsStr.split(',').map(s => s.trim()) : [];

      const hay = [
        card.getAttribute('data-name') || '',
        card.getAttribute('data-manufacturer') || '',
        card.getAttribute('data-model') || ''
      ].join(' ');

      const matchesCapability = (selectedCapability === 'all') || cardModsList.includes(selectedCapability);
      const matchesQ = (!q) || hay.includes(q);

      card.style.display = (matchesCapability && matchesQ) ? '' : 'none';
    });
  }

  capabilityEl.addEventListener('change', applyFilters);
  searchEl.addEventListener('input', applyFilters);
})();
</script>
